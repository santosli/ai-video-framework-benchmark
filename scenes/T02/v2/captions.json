{
  "case_id": "T02",
  "version": 2,
  "captions": [
    {
      "id": "V008-c019",
      "segment_id": "V008",
      "speaker": "A",
      "text": "为了保证“比赛”尽量客观",
      "start": 0.273,
      "end": 2.313
    },
    {
      "id": "V008-c020",
      "segment_id": "V008",
      "speaker": "A",
      "text": "这次测试统一了四个条件",
      "start": 2.313,
      "end": 4.033
    },
    {
      "id": "V009-c021",
      "segment_id": "V009",
      "speaker": "A",
      "text": "1. 同一个声音",
      "start": 4.413,
      "end": 6.853
    },
    {
      "id": "V009-c022",
      "segment_id": "V009",
      "speaker": "A",
      "text": "每家都克隆同一套男女声参考音频",
      "start": 6.853,
      "end": 9.833
    },
    {
      "id": "V009-c023",
      "segment_id": "V009",
      "speaker": "A",
      "text": "纯看模型还原的硬实力",
      "start": 9.833,
      "end": 11.433
    },
    {
      "text": "2. 同一段文字。",
      "start": 12.047015065426997,
      "end": 13.428280303030302,
      "id": "V010x-0",
      "speaker": "A"
    },
    {
      "text": "准备了 7 段内容，",
      "start": 14.429197141873278,
      "end": 15.410095643939393,
      "id": "V010x-1",
      "speaker": "A"
    },
    {
      "text": "涵盖知识口播、带货、日常闲聊，",
      "start": 15.91055406336088,
      "end": 18.633047865013772,
      "id": "V010x-2",
      "speaker": "A"
    },
    {
      "text": "还有容易翻车的中英混读、多音字和数字日期。",
      "start": 19.15352462121212,
      "end": 22.3764768422865,
      "id": "V010x-3",
      "speaker": "A"
    },
    {
      "text": "知识口播那段，男女声各测了一次。",
      "start": 23.517522038567492,
      "end": 25.919722451790633,
      "id": "V010x-4",
      "speaker": "A"
    },
    {
      "id": "V011-c028",
      "segment_id": "V011",
      "speaker": "A",
      "text": "3. 同一批生成",
      "start": 26.331333,
      "end": 28.981333
    },
    {
      "id": "V011-c029",
      "segment_id": "V011",
      "speaker": "A",
      "text": "每家每段只跑一次",
      "start": 28.981333,
      "end": 30.681333
    },
    {
      "id": "V011-c030",
      "segment_id": "V011",
      "speaker": "A",
      "text": "参数全用默认",
      "start": 30.681333,
      "end": 32.141333
    },
    {
      "id": "V011-c031",
      "segment_id": "V011",
      "speaker": "A",
      "text": "不挑也不反复抽卡",
      "start": 32.141333,
      "end": 34.101333
    },
    {
      "id": "V011-c032",
      "segment_id": "V011",
      "speaker": "A",
      "text": "模拟日常的实际使用情况",
      "start": 34.101333,
      "end": 35.521333
    },
    {
      "id": "V012-c033",
      "segment_id": "V012",
      "speaker": "A",
      "text": "4. 同一响度",
      "start": 35.965333,
      "end": 37.855333
    },
    {
      "id": "V012-c034",
      "segment_id": "V012",
      "speaker": "A",
      "text": "所有音频统一做了响度对齐",
      "start": 37.855333,
      "end": 40.515333
    },
    {
      "id": "V012-c035",
      "segment_id": "V012",
      "speaker": "A",
      "text": "避免音量大小影响听感判断",
      "start": 40.515333,
      "end": 42.595333
    }
  ],
  "planned_windows_only": false
}
